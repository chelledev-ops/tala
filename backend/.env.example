# Copy to backend/.env and fill in. Never commit the real .env.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=tala

# Auth
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Staff accounts seeded on first start (use strong passwords)
ADMIN_EMAIL=admin@example.gov.ph
ADMIN_PASSWORD=
REVIEWER_EMAIL=reviewer@example.gov.ph
REVIEWER_PASSWORD=
AUDITOR_EMAIL=auditor@example.gov.ph
AUDITOR_PASSWORD=

# Stellar Testnet (TALA refuses any other network)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_PUBLIC_KEY=
STELLAR_SECRET_KEY=

# Soroban attestation contract. Leave TALA_CONTRACT_ID empty to anchor with a
# transaction memo instead. The account above must be an attester on the contract.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
TALA_CONTRACT_ID=

# S3-compatible evidence storage
S3_BUCKET=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
